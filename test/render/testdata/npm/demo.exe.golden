# Generated by spine v0.0.0-test. Do not edit.
# It has no shebang line on purpose: bin linkers choose the interpreter of a bin
# from its first line when they link it, and this file is replaced by the native
# binary afterwards. Without a shebang, the linked wrappers call the file itself.
self=$0
hops=0
while [ -L "$self" ] && [ "$hops" -lt 40 ]; do
  hops=$((hops + 1))
  target=$(readlink -- "$self")
  case $target in
    /*) self=$target ;;
    *) self=$(dirname -- "$self")/$target ;;
  esac
done
script=$(CDPATH='' cd -P -- "$(dirname -- "$self")" && pwd)/install.js
quoted=$(printf '%s' "$script" | sed "s/'/'\\\\''/g")
{
  printf '%s\n' "demo: the binary is not installed. The package install script did not run,"
  printf '%s\n' "for example because of --ignore-scripts or a package manager that blocks install scripts."
  printf '%s\n' "To install it, run:"
  printf "  node '%s'\n" "$quoted"
} >&2
exit 2
