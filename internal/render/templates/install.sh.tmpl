#!/bin/sh
# Generated by spine {% .Generator %} from spine.json. Do not edit.
#
# {% .Name %} - {% comment .Summary %}
# Installs {% .Name %} from a GitHub release.
#
#   {% .EnvVar "VERSION" %}
#       Release tag to install (default: latest release).
#   {% .EnvVar "TRACK" %}
#       stable (default), alpha, beta or rc: installs the newest release on that
#       track's upgrade path (rc: rc or stable, beta: beta, rc or stable, alpha:
#       alpha, beta, rc or stable). {% .EnvVar "VERSION" %} takes precedence.
#   {% .EnvVar "INSTALL_DIR" %}
#       Install directory (default: {% .InstallDir "linux" %}).
#   {% .EnvVar "NO_MODIFY_PATH" %}
#       Set to 1 to not add the install directory to your shell profile when it is
#       not on PATH (default: it is added).
#   {% .EnvVar "DOWNLOAD_BASE_URL" %}
#       Mirror for release assets, fetched as <base>/<tag>/<asset>. Requires
#       {% .EnvVar "VERSION" %}. Must start with https:// or file:// (file:// needs curl).
#       checksums.txt comes from the same base, so verification is only as
#       trustworthy as the mirror.
#   {% .EnvVar "GITHUB_TOKEN" %}
#       GitHub token for the release lookup, to stay clear of the API rate limit
#       (default: none). Sent as a bearer token only to https://api.github.com/,
#       never with the asset downloads.
#
# curl enforces https on redirects too. wget enforces https only on the start URL,
# not on redirects.

set -eu

REPO={% .Repo %}
bin={% .BinaryName "linux" %}
tmp=
staged=
proto='=https'

say() { printf '%s\n' "$*" >&2; }
die() {
  say "install.sh: error: $*"
  exit 1
}
have() { command -v "$1" >/dev/null 2>&1; }

cleanup() {
  if [ -n "$staged" ]; then rm -f "$staged"; fi
  if [ -n "$tmp" ]; then rm -rf "$tmp"; fi
}

download() {
  url=$1
  out=$2
  hint=${3:-}
  auth_token=
  case $url in
    https://api.github.com/*) auth_token=${{% .EnvVar "GITHUB_TOKEN" %}:-} ;;
  esac
  if have curl; then
    set -- curl -fsSL --proto "$proto" --proto-redir '=https' --tlsv1.2 --connect-timeout 15 --retry 2 -o "$out"
    [ -z "$auth_token" ] || set -- "$@" -H "Authorization: Bearer $auth_token"
  else
    set -- wget -q -T 15 --https-only -O "$out"
    [ -z "$auth_token" ] || set -- "$@" "--header=Authorization: Bearer $auth_token"
  fi
  "$@" "$url" || die "download failed: $url${hint:+. $hint}"
}

sha256_of() {
  if have sha256sum; then
    sha256sum "$1" | awk '{ print $1 }'
  else
    shasum -a 256 "$1" | awk '{ print $1 }'
  fi
}

detect_platform() {
  os=$(uname -s)
  arch=$(uname -m)
  case $os in
    Darwin) goos=darwin ;;
    Linux) goos=linux ;;
    MINGW* | MSYS* | CYGWIN*)
      die "Windows shells are not supported. Run install.ps1 in PowerShell{% if .Channels.Npm.Package %}, or install with npm (npm install -g {% .Channels.Npm.Package %}){% end %}."
      ;;
    *) die "unsupported operating system: $os" ;;
  esac
  case $arch in
    x86_64 | amd64) goarch=amd64 ;;
    arm64 | aarch64) goarch=arm64 ;;
    *) die "unsupported architecture: $arch" ;;
  esac
  # A shell running under Rosetta reports x86_64 on Apple Silicon.
  if [ "$goos" = darwin ] && [ "$goarch" = amd64 ] &&
    [ "$(sysctl -n sysctl.proc_translated 2>/dev/null || true)" = 1 ]; then
    goarch=arm64
  fi
}

# Prints a path with the symlinks in its existing part resolved.
physical_path() {
  p=$1
  rest=
  while [ ! -d "$p" ]; do
    rest=/$(basename "$p")$rest
    p=$(dirname "$p")
  done
  printf '%s%s\n' "$(cd "$p" && pwd -P)" "$rest"
}

# Like physical_path, but also follows symlinks in the last component.
resolved_path() {
  p=$1
  hops=0
  while [ -L "$p" ] && [ "$hops" -le 20 ]; do
    hops=$((hops + 1))
    link=$(readlink "$p")
    case $link in
      /*) p=$link ;;
      *) p=$(dirname "$p")/$link ;;
    esac
  done
  physical_path "$p"
}

managed_path() {
  case "/$(printf '%s' "$1" | tr '[:upper:]' '[:lower:]')/" in
    */cellar/* | */caskroom/* | */node_modules/* | */chocolatey/*) return 0 ;;
  esac
  return 1
}

# Refuses a path, or a symlink chain starting at it, that resolves into a
# directory owned by Homebrew, npm or Chocolatey.
refuse_managed() {
  path=$1
  hops=0
  while :; do
    if managed_path "$(physical_path "$path")"; then
      die "refusing to install over $1: it resolves into a Homebrew, npm or Chocolatey install. Upgrade through that package manager, or choose another directory with {% .EnvVar "INSTALL_DIR" %}."
    fi
    [ -L "$path" ] || return 0
    hops=$((hops + 1))
    [ "$hops" -le 20 ] || die "too many symlinks resolving $1"
    link=$(readlink "$path")
    case $link in
      /*) path=$link ;;
      *) path=$(dirname "$path")/$link ;;
    esac
  done
}

# Prints the highest release of the upgrade path $1 in the releases list $2, like
# release.HighestInPath. Drafts and tags that are not vX.Y.Z, vX.Y.Z-(alpha|beta|rc).N
# with N >= 1 are ignored.
# Newlines are dropped and each object member is put on its own line, so the layout of
# the JSON does not matter. Inside a string value every quote is escaped, so a
# "tag_name" or "draft" key at the start of a line is never part of a release body.
highest_in_path() {
  # shellcheck disable=SC2020 # maps both , and { to newline
  tr -d '\r\n' <"$2" | tr ',{' '\n\n' | awk -v path=" $1 " '
    function pad(s) {
      while (length(s) < 20) s = "0" s
      return s
    }
    function consider(t,   core, pre, i, v, p, name, rank, key) {
      if (t !~ /^v(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)(-(alpha|beta|rc)\.[1-9][0-9]*)?$/) return
      core = substr(t, 2)
      pre = ""
      i = index(core, "-")
      if (i) {
        pre = substr(core, i + 1)
        core = substr(core, 1, i - 1)
      }
      split(core, v, ".")
      split(pre, p, ".")
      name = pre == "" ? "stable" : p[1]
      if (!index(path, " " name " ")) return
      rank = name == "alpha" ? 1 : name == "beta" ? 2 : name == "rc" ? 3 : 9
      key = pad(v[1]) pad(v[2]) pad(v[3]) rank pad(p[2])
      if (best == "" || key > bestkey) {
        best = t
        bestkey = key
      }
    }
    # A release is complete once both of its keys were seen, in either order.
    function flush() {
      if (hastag && draft != "t") consider(tag)
      hastag = 0
      tag = ""
      draft = ""
    }
    /^[ \t]*"tag_name"[ \t]*:/ {
      if (hastag) flush()
      hastag = 1
      tag = $0
      sub(/^[^:]*:[ \t]*"/, "", tag)
      sub(/".*/, "", tag)
      if (draft != "") flush()
    }
    /^[ \t]*"draft"[ \t]*:/ {
      if (draft != "") flush()
      draft = ($0 ~ /:[ \t]*true/) ? "t" : "f"
      if (hastag) flush()
    }
    END {
      flush()
      if (best != "") print best
    }
  '
}

resolve_tag() {
  track=${{% .EnvVar "TRACK" %}:-stable}
  case $track in
{%- range .Tracks %}
    {% .Name %}) track_path='{% join .Path " " %}' ;;
{%- end %}
    *) die "{% .EnvVar "TRACK" %} must be one of stable, alpha, beta or rc, got: $track" ;;
  esac
  if [ -n "${{% .EnvVar "VERSION" %}:-}" ]; then
    tag=${% .EnvVar "VERSION" %}
    case $tag in
      *[!0-9A-Za-z.v-]*) ;;
      *) printf '%s\n' "$tag" |
        grep -Eq '^v(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)(-[0-9A-Za-z.-]+)?$' && return 0 ;;
    esac
    die "{% .EnvVar "VERSION" %} must be a release tag like v1.2.3, got: $tag"
  fi
  [ -z "${{% .EnvVar "DOWNLOAD_BASE_URL" %}:-}" ] ||
    die "{% .EnvVar "VERSION" %} is required when {% .EnvVar "DOWNLOAD_BASE_URL" %} is set"
  if [ "$track" != stable ]; then
    # per_page=100 on purpose: wider than the CLI's 30, so a busy track is less likely to fall off the page.
    download "https://api.github.com/repos/$REPO/releases?per_page=100" "$tmp/releases.json" \
      "This may be a GitHub API rate limit. Set {% .EnvVar "VERSION" %} to install a specific tag."
    tag=$(highest_in_path "$track_path" "$tmp/releases.json") || die "could not read the releases list"
    [ -n "$tag" ] || die "no release found on the $track track. Set {% .EnvVar "VERSION" %} to install a specific tag."
    return 0
  fi
  download "https://api.github.com/repos/$REPO/releases/latest" "$tmp/latest.json" \
    "This may be a GitHub API rate limit. Set {% .EnvVar "VERSION" %} to install a specific tag."
  tag=$(sed -n 's/.*"tag_name"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$tmp/latest.json" | head -n 1)
  printf '%s\n' "$tag" |
    grep -Eq '^v(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)$' ||
    die "could not determine the latest release (got '$tag'). Set {% .EnvVar "VERSION" %} to install a specific tag."
}

verify_checksum() {
  want=$(tr -d '\r' <"$3" | awk -v name="$2" '$2 == name || $2 == "*" name { print $1 }' | tr 'A-F' 'a-f')
  case $want in
    "") die "checksums.txt has no line for $2. Nothing was installed." ;;
    *[!0-9a-f]*) die "checksums.txt has a duplicate or malformed line for $2. Nothing was installed." ;;
  esac
  [ "${#want}" -eq 64 ] || die "checksums.txt has a malformed line for $2. Nothing was installed."
  got=$(sha256_of "$1")
  [ "$got" = "$want" ] ||
    die "checksum mismatch for $2 (expected $want, got $got). Nothing was installed."
}

# Adds dir to PATH in the profile of the login shell. Returns 1, having changed
# nothing, when that is opted out of, unsafe to quote or not possible, so the
# caller falls back to the hint.
add_to_profile() {
  [ "${{% .EnvVar "NO_MODIFY_PATH" %}:-}" != 1 ] || return 1
  [ -n "${HOME:-}" ] || return 1
  case $dir in
    *\'* | *\\* | *'
'*) return 1 ;;
  esac
  line="export PATH='$dir':\"\$PATH\""
  login_shell=${SHELL:-}
  case ${login_shell##*/} in
    zsh) profile=${ZDOTDIR:-$HOME}/.zshrc ;;
    bash)
      # Linux: a login shell that reads an existing ~/.bash_profile or ~/.bash_login
      # without sourcing ~/.bashrc will not see this.
      profile=$HOME/.bashrc
      if [ "$goos" = darwin ]; then
        # Terminal starts login shells, which read only the first of these that exists.
        profile=$HOME/.bash_profile
        for f in .bash_profile .bash_login .profile; do
          if [ -f "$HOME/$f" ]; then
            profile=$HOME/$f
            break
          fi
        done
      fi
      ;;
    fish)
      profile=${XDG_CONFIG_HOME:-$HOME/.config}/fish/conf.d/{% .Name %}.fish
      line="set -gx PATH '$dir' \$PATH"
      ;;
    '' | sh | dash | ksh | ash) profile=$HOME/.profile ;;
    *) return 1 ;;
  esac
  # Idempotent on the exact line only: an equivalent line written by hand may be duplicated.
  if [ -f "$profile" ] && grep -qxF "$line" "$profile"; then
    say "$profile already adds $dir to your PATH"
  else
    { mkdir -p "$(dirname "$profile")" &&
      printf '\n# added by {% .Name %} install.sh\n%s\n' "$line" >>"$profile"; } 2>/dev/null || return 1
    say "Added $dir to your PATH in $profile"
  fi
  say "Open a new terminal to use {% .Name %}, or run: $line"
}

report() {
  case ":$PATH:" in
    *":$dir:"* | *":$dir/:"*)
      found=$(command -v "$bin" 2>/dev/null || true)
      if [ -n "$found" ] && [ "$(resolved_path "$found")" != "$(physical_path "$dir/$bin")" ]; then
        say "warning: $found comes first on PATH and will shadow the {% .Name %} installed in $dir"
      fi
      ;;
    *) add_to_profile || say "$dir is not on your PATH. Add it with: export PATH=\"$dir:\$PATH\"" ;;
  esac
}
{%- if .Alias %}

# Never replaces anything it did not create: a foreign file at the alias path is kept.
link_alias() {
  alias_path=$dir/{% .AliasBinaryName "linux" %}
  if [ -L "$alias_path" ] && [ "$(readlink "$alias_path")" = "$bin" ]; then
    return 0
  fi
  if [ -e "$alias_path" ] || [ -L "$alias_path" ]; then
    say "warning: $alias_path already exists, skipping the {% .Alias %} alias"
    return 0
  fi
  ln -s "$bin" "$alias_path" || say "warning: could not create $alias_path, skipping the {% .Alias %} alias"
}
{%- end %}

main() {
  have curl || have wget || die "curl or wget is required"
  have curl || wget --help 2>&1 | grep -q -e --https-only ||
    die "this wget does not support --https-only. Install curl."
  have sha256sum || have shasum || die "sha256sum or shasum is required"
  have tar || die "tar is required"

  if [ -n "${{% .EnvVar "DOWNLOAD_BASE_URL" %}:-}" ]; then
    case ${% .EnvVar "DOWNLOAD_BASE_URL" %} in
      https://*) ;;
      file://*)
        have curl || die "{% .EnvVar "DOWNLOAD_BASE_URL" %} with file:// requires curl; wget does not support file://"
        proto='=https,file'
        ;;
      *) die "{% .EnvVar "DOWNLOAD_BASE_URL" %} must start with https:// or file://, got: ${% .EnvVar "DOWNLOAD_BASE_URL" %}" ;;
    esac
    say "warning: {% .EnvVar "DOWNLOAD_BASE_URL" %} is set, downloading from ${% .EnvVar "DOWNLOAD_BASE_URL" %} instead of GitHub"
  fi

  detect_platform

  if [ -n "${{% .EnvVar "INSTALL_DIR" %}:-}" ]; then
    dir=${% .EnvVar "INSTALL_DIR" %}
  else
    [ -n "${HOME:-}" ] || die "HOME is not set; set {% .EnvVar "INSTALL_DIR" %}"
    dir=$HOME/{% trimPrefix (.InstallDir "linux") "~/" %}
  fi
  case $dir in
    /*) ;;
    *) dir=$PWD/$dir ;;
  esac
  dir=${dir%/}
  refuse_managed "$dir/$bin"

  trap cleanup EXIT
  trap 'exit 129' HUP
  trap 'exit 130' INT
  trap 'exit 143' TERM
  trap 'exit 141' PIPE
  tmp=$(mktemp -d "${TMPDIR:-/tmp}/{% .Name %}-install.XXXXXX") || die "cannot create a temporary directory"

  resolve_tag
  archive={% .Name %}_${tag#v}_${goos}_${goarch}.tar.gz
  base=${{% .EnvVar "DOWNLOAD_BASE_URL" %}:-https://github.com/$REPO/releases/download}
  base=${base%/}

  say "Downloading {% .Name %} $tag for $goos/$goarch"
  download "$base/$tag/$archive" "$tmp/$archive"
  download "$base/$tag/checksums.txt" "$tmp/checksums.txt"
  verify_checksum "$tmp/$archive" "$archive" "$tmp/checksums.txt"

  mkdir "$tmp/extract"
  tar -xzf "$tmp/$archive" -C "$tmp/extract" "$bin" || die "could not extract {% .Name %} from $archive"
  if ! [ -f "$tmp/extract/$bin" ] || [ -L "$tmp/extract/$bin" ]; then
    die "$archive does not hold a {% .Name %} binary at its root"
  fi

  mkdir -p "$dir" || die "cannot create $dir"
  staged=$(mktemp "$dir/.$bin.XXXXXX") || die "cannot write to $dir"
  cp "$tmp/extract/$bin" "$staged"
  chmod 755 "$staged"
  # mv would move into the directory instead of replacing it.
  if [ -d "$dir/$bin" ]; then
    die "$dir/$bin is a directory or a symlink to one"
  fi
  mv -f "$staged" "$dir/$bin"
  staged=
{%- if .Alias %}
  link_alias
{%- end %}

  printf 'Installed {% .Name %} %s to %s\n' "$tag" "$dir"
  report
}

main "$@"
